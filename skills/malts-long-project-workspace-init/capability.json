  "display_name": "MALTS Long Project Workspace Init",
  "short_description": "Initialize, recover, and govern long workspaces",
  "triggers": [
    "initialize a phase-ready long MALTS project workspace",
    "perform structural workspace recovery or explicit CURRENT reorganization",
    "review or transition a MALTS Phase boundary",
    "opt in to resource-admitted parallel Phase work",
    "pause resume or supersede a MALTS Phase",
    "audit enroll register promote supersede or reconcile workspace Artifacts",
    "compact MALTS project history safely"
  ],
  "applicability": {
    "task_types": [
      "long-project-initialization",
      "phase-lifecycle",
      "artifact-lifecycle",
      "workspace-maintenance",
      "workspace-recovery"
    ],
    "modes": [
      "single-agent",
      "multi-agent",
      "review-only"
    ],
    "conditions": [
      "The work is long-running, phase-oriented, interruption-prone, or recovery-sensitive."
    ],
    "contraindications": [
      "The task is S0/S1 or the user requested no project control artifacts.",
      "An initialized unchanged workspace only needs the read-only workspace-entry path; do not rerun full initialization."
    ]
  },
  "inputs": [
    "workspace path",
    "project identifier",
    "original goal",
    "initial Phase identifier",
    "initial Phase goal",
    "narrative language",
    "explicit operation authorization"
  ],
  "outputs": [
    "phase-ready long-project workspace",
    "bounded workspace-entry assessment",
    "reviewed Phase boundary and transition evidence",
    "explicit later Phase and Session controls",
    "optional resource Admission and fencing evidence",
    "optional owner-local Artifact registries and Shared or Archive indexes",
    "on-demand maintenance views",
    "ordered recovery evidence"
  ],
  "risks": {
    "risk_class": "medium",
    "factors": [
      "scripts",
      "write"
    ],
    "forbidden_effects": [
      "Do not report initialization complete without a registered initial Phase.",
      "Do not rerun initialization for ordinary unchanged task entry.",
      "Do not overwrite user files.",
      "Do not enroll resource coordination or Artifact lifecycle or create a Session implicitly.",
      "Do not move or delete Artifact payloads or invoke VCS.",
      "Do not treat runtime state or maintenance views as canonical truth.",
      "Do not schedule automatic update checks."
    ]
  },
  "required_permissions": [
    "read-files",
    "write-project-files"
  ],
