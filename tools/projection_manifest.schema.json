{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:projection-manifest:1",
  "title": "MALTS Projection Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_schema_version",
    "manifest_id",
    "active_generation",
    "tool",
    "target_tool",
    "target_tool_version",
    "adapter_version",
    "source_revision",
    "malts_version",
    "package_variant",
    "source_tree_sha256",
    "projected_tree_sha256",
    "generated_at",
    "created_by",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "projection_schema_version": {"const": 1},
    "manifest_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "active_generation": {"type": "string", "minLength": 1},
    "tool": {"enum": ["codex", "claude-code", "opencode"]},
    "target_tool": {"enum": ["codex", "claude-code", "opencode"]},
    "target_tool_version": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "malts_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "package_variant": {"enum": ["local", "public"]},
    "source_tree_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "projected_tree_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/projectionEntry"}}
  },
  "$defs": {
    "projectionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "source_relative_path",
        "source_sha256",
        "target",
        "projection_type",
        "generated_sha256",
        "ownership",
        "created_by",
        "required_dependencies",
        "verification_refs"
      ],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "source_relative_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "target": {"type": "string", "minLength": 1},
        "projection_type": {"enum": ["native", "overlay", "junction"]},
        "generated_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "ownership": {"const": "malts"},
        "created_by": {"type": "string", "minLength": 1},
        "required_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "verification_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
