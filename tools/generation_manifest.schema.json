{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:generation-manifest:1",
  "title": "MALTS Immutable Generation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generation_id", "version", "artifact_sha256", "source_revision",
    "package_tree_sha256", "package_inventory_sha256", "supported_platforms", "supported_tools",
    "migration_handlers", "minimum_prerequisites", "projection_classification", "user_purity", "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_revision": {"type": "string", "minLength": 1},
    "package_tree_sha256": {"$ref": "#/$defs/sha256"},
    "package_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "supported_platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["windows"]}},
    "supported_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["codex", "claude-code", "opencode"]}},
    "migration_handlers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["A", "B", "C", "D"]}},
    "minimum_prerequisites": {"type": "array", "items": {"$ref": "#/$defs/prerequisite"}},
    "projection_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_contract_paths", "generated_state_paths"],
      "properties": {
        "public_contract_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "generated_state_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "user_purity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_sha256", "file_count", "tree_sha256", "identity_release_status"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "identity_release_status": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version_constraint", "required", "applicability"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version_constraint": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "applicability": {"enum": ["always", "selected-tool"]},
        "tool": {"enum": ["codex", "claude-code", "opencode"]}
      },
      "allOf": [
        {
          "if": {"properties": {"applicability": {"const": "selected-tool"}}},
          "then": {"required": ["tool"]}
        },
        {
          "if": {"properties": {"applicability": {"const": "always"}}},
          "then": {"not": {"required": ["tool"]}}
        }
      ]
    }
  }
}
