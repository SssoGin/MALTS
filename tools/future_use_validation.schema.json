{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:future-use-validation:1",
  "title": "MALTS Future-Use Validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation_id", "candidate_id", "future_task_id", "independence_key", "use_index", "validation_kind", "outcome", "severity", "evidence_refs", "challenge_case", "reviewer", "validated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "validation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "future_task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "independence_key": {"type": "string", "minLength": 1},
    "use_index": {"type": "integer", "minimum": 1},
    "validation_kind": {"enum": ["future_use", "independent_review", "negative_test", "counterexample"]},
    "outcome": {"enum": ["helped", "neutral", "harmful", "inconclusive"]},
    "severity": {"enum": ["none", "low", "medium", "high", "critical"]},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "challenge_case": {"type": "boolean"},
    "reviewer": {"type": "string", "minLength": 1},
    "validated_at": {"type": "string", "format": "date-time"}
  }
}
