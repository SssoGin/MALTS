{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:release-manifest:2",
  "title": "MALTS Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_id", "version", "release_state", "source", "artifact",
    "supported_platforms", "supported_tools", "migration_handlers", "minimum_prerequisites",
    "user_purity", "public_repository", "release_notes", "transport_contract", "gates", "known_blockers",
    "remote_publication_status", "created_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "release_id": {"type": "string", "pattern": "^MALTS-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "release_state": {"enum": ["candidate", "release-ready"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "tree_sha256", "provenance_kind"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_kind": {"enum": ["local-canonical-tree", "verified-working-tree", "git-commit"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root", "artifact_sha256", "generation_id", "generation_manifest_sha256",
        "package_inventory_sha256", "package_tree_sha256", "release_inventory_sha256",
        "release_file_count"
      ],
      "properties": {
        "root": {"const": "lifecycle_artifact"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "generation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "generation_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "package_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "package_tree_sha256": {"$ref": "#/$defs/sha256"},
        "release_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "release_file_count": {"type": "integer", "minimum": 1}
      }
    },
    "supported_platforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["windows"]}
    },
    "supported_tools": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["codex", "claude-code", "opencode"]}
    },
    "migration_handlers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["A", "B", "C", "D"]}
    },
    "minimum_prerequisites": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/prerequisite"}
    },
    "user_purity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_sha256", "file_count", "tree_sha256", "identity_release_status"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "identity_release_status": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "public_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile", "file_count", "tree_sha256", "repository_only_file_count",
        "repository_only_tree_sha256", "repository_only_files"
      ],
      "properties": {
        "profile": {"const": "MALTS-USER-PAYLOAD-PLUS-REPOSITORY-ONLY-v1"},
        "file_count": {"type": "integer", "minimum": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "repository_only_file_count": {"type": "integer", "minimum": 1},
        "repository_only_tree_sha256": {"$ref": "#/$defs/sha256"},
        "repository_only_files": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file-record"}
        }
      }
    },
    "release_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "safety_status", "safety_evidence_refs"],
      "properties": {
        "path": {"const": "RELEASE_NOTES.md"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "safety_status": {"const": "PASS"},
        "safety_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "transport_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_format", "deterministic_profile", "verification_mode",
        "top_level_directory", "hosted_asset_kinds"
      ],
      "properties": {
        "archive_format": {"const": "zip"},
        "deterministic_profile": {"const": "MALTS-ZIP-STORED-UTC-1980-v1"},
        "verification_mode": {"const": "extract-and-verify-release-package"},
        "top_level_directory": {"type": "string", "pattern": "^MALTS-[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "hosted_asset_kinds": {
          "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
          "items": {"const": "archive"}
        }
      }
    },
    "gates": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "evidence_refs"],
        "properties": {
          "gate_id": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5"]},
          "status": {"enum": ["PASS", "PENDING", "PENDING_REMOTE_CONFIRMATION", "BLOCKED"]},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "known_blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "remote_publication_status": {"const": "not-performed"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "relative-path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "file-record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative-path"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version_constraint", "required", "applicability"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version_constraint": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "applicability": {"enum": ["always", "selected-tool"]},
        "tool": {"enum": ["codex", "claude-code", "opencode"]}
      },
      "allOf": [
        {
          "if": {"properties": {"applicability": {"const": "selected-tool"}}},
          "then": {"required": ["tool"]}
        },
        {
          "if": {"properties": {"applicability": {"const": "always"}}},
          "then": {"not": {"required": ["tool"]}}
        }
      ]
    }
  }
}
