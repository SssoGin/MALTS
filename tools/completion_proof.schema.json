{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:completion-proof:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_sha256", "verification", "artifacts", "remaining_work"],
  "properties": {
    "contract_sha256": {"$ref": "#/$defs/hash"},
    "verification": {"type": "array", "items": {"$ref": "#/$defs/verification"}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "remaining_work": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "result", "evidence_level", "evidence_refs", "artifact_ids"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "result": {"enum": ["PASS", "FAIL", "NOT_RUN", "TODO"]},
        "evidence_level": {"enum": ["A", "B", "C", "D"]},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "artifact_ids": {"$ref": "#/$defs/strings"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
