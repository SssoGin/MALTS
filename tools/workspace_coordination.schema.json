{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:workspace-coordination:1",
  "title": "MALTS Workspace Resource Admission State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workspace_schema_version", "workspace_id", "profile", "revision",
    "updated_at", "next_event_sequence", "fencing_domains", "active_admissions", "queue",
    "quarantines", "workspace_quarantine", "last_event"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_schema_version": {"const": 5},
    "workspace_id": {"$ref": "#/$defs/id"},
    "profile": {"enum": ["resource_admission", "resource_admission_v1"]},
    "revision": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "string", "format": "date-time"},
    "next_event_sequence": {"type": "integer", "minimum": 1},
    "fencing_domains": {"type": "array", "items": {"$ref": "#/$defs/fencingDomain"}},
    "active_admissions": {"type": "array", "items": {"$ref": "#/$defs/admission"}},
    "queue": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/queueEntry"}},
    "quarantines": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/quarantine"}},
    "workspace_quarantine": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["quarantine_id", "admission_id", "phase_id", "reason", "recorded_at", "evidence_refs"],
      "properties": {
        "quarantine_id": {"$ref": "#/$defs/id"}, "admission_id": {"$ref": "#/$defs/id"}, "phase_id": {"$ref": "#/$defs/id"},
        "reason": {"const": "WORKSPACE_AUTHORITY_UNKNOWN"}, "recorded_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "last_event": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["sequence", "event_id", "path", "sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1}, "event_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "pattern": "^runtime[/\\\\]workspace_coordination_events[/\\\\][A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": {"kind": {"enum": ["MAIN_CONTROLLER", "DELEGATED_AGENT", "TOOL_ADAPTER", "SYSTEM_RECOVERY"]}, "id": {"$ref": "#/$defs/id"}}
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "locator_id", "kind", "scope", "access", "value", "aliases", "backing_paths",
        "canonical_value", "canonical_aliases", "canonical_backing_paths", "physical_paths", "physical_file_ids",
        "physical_identity_status", "physical_identity_errors", "physical_identity_sha256", "identity_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1}, "locator_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["PATH", "ARTIFACT", "RECORD", "SERVICE", "DEVICE", "ENVIRONMENT"]},
        "scope": {"enum": ["WORKSPACE", "EXTERNAL", "GLOBAL"]}, "access": {"enum": ["READ", "WRITE"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 2048},
        "aliases": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
        "backing_paths": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/backingPath"}},
        "canonical_value": {"type": "string", "minLength": 1},
        "canonical_aliases": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "canonical_backing_paths": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalBackingPath"}},
        "physical_paths": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "physical_file_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^MALTS-FILE-ID:[A-F0-9]{64}$"}},
        "physical_identity_status": {"enum": ["KNOWN", "UNKNOWN", "NOT_APPLICABLE"]},
        "physical_identity_errors": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^LOCATOR_[A-Z0-9_]+$"}},
        "physical_identity_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "backingPath": {
      "type": "object", "additionalProperties": false, "required": ["scope", "value"],
      "properties": {"scope": {"enum": ["WORKSPACE", "EXTERNAL"]}, "value": {"type": "string", "minLength": 1, "maxLength": 2048}}
    },
    "canonicalBackingPath": {
      "type": "object", "additionalProperties": false, "required": ["scope", "canonical_value"],
      "properties": {"scope": {"enum": ["WORKSPACE", "EXTERNAL"]}, "canonical_value": {"type": "string", "minLength": 1}}
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "mode", "fenceable", "isolation_key"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["SHARED", "EXCLUSIVE", "QUEUED", "ISOLATE_REQUIRED"]},
        "fenceable": {"type": "boolean"},
        "isolation_key": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
      }
    },
    "fencingToken": {
      "type": "object", "additionalProperties": false, "required": ["domain_id", "epoch"],
      "properties": {"domain_id": {"$ref": "#/$defs/id"}, "epoch": {"type": "integer", "minimum": 1}}
    },
    "fencingDomain": {
      "type": "object", "additionalProperties": false,
      "required": ["domain_id", "domain_kind", "resource_kind", "scope", "canonical_value", "epoch"],
      "properties": {
        "domain_id": {"$ref": "#/$defs/id"}, "domain_kind": {"enum": ["LOCATOR", "CAPABILITY"]},
        "resource_kind": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1},
        "canonical_value": {"type": "string", "minLength": 1}, "epoch": {"type": "integer", "minimum": 1}
      }
    },
    "admissionRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["request_version", "admission_id", "phase_id", "phase_control_sha256", "actor", "expires_at", "authorization_ref", "locators", "capabilities", "evidence_refs"],
      "properties": {
        "request_version": {"const": 1}, "admission_id": {"$ref": "#/$defs/id"}, "phase_id": {"$ref": "#/$defs/id"},
        "phase_control_sha256": {"$ref": "#/$defs/sha256"},
        "actor": {"$ref": "#/$defs/actor"}, "expires_at": {"type": "string", "format": "date-time"},
        "authorization_ref": {"type": "string", "minLength": 1},
        "locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "admission": {
      "type": "object", "additionalProperties": false,
      "required": [
        "request_version", "admission_id", "phase_id", "phase_control_sha256", "actor", "expires_at", "authorization_ref",
        "locators", "capabilities", "evidence_refs", "request_sha256", "granted_at",
        "fencing_tokens", "requires_explicit_reconcile_on_expiry"
      ],
      "properties": {
        "request_version": {"const": 1}, "admission_id": {"$ref": "#/$defs/id"}, "phase_id": {"$ref": "#/$defs/id"},
        "phase_control_sha256": {"$ref": "#/$defs/sha256"},
        "actor": {"$ref": "#/$defs/actor"}, "expires_at": {"type": "string", "format": "date-time"},
        "authorization_ref": {"type": "string", "minLength": 1},
        "locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}, "request_sha256": {"$ref": "#/$defs/sha256"},
        "granted_at": {"type": "string", "format": "date-time"},
        "fencing_tokens": {"type": "array", "items": {"$ref": "#/$defs/fencingToken"}},
        "requires_explicit_reconcile_on_expiry": {"type": "boolean"}
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["conflict_class", "held_admission_id", "requested_id", "held_id", "relationship"],
      "properties": {
        "conflict_class": {"enum": ["LOCATOR", "CAPABILITY", "QUARANTINE", "WORKSPACE_QUARANTINE", "QUEUE_ORDER"]},
        "held_admission_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "requested_id": {"type": "string", "minLength": 1}, "held_id": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "minLength": 1}
      }
    },
    "queueEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["queued_at", "request_sha256", "request", "conflicts"],
      "properties": {
        "queued_at": {"type": "string", "format": "date-time"}, "request_sha256": {"$ref": "#/$defs/sha256"},
        "request": {"$ref": "#/$defs/admissionRequest"}, "conflicts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conflict"}}
      }
    },
    "quarantineDomain": {
      "type": "object", "additionalProperties": false,
      "required": ["domain_kind", "resource_kind", "scope", "canonical_value"],
      "properties": {
        "domain_kind": {"enum": ["LOCATOR", "CAPABILITY"]}, "resource_kind": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}, "canonical_value": {"type": "string", "minLength": 1}
      }
    },
    "quarantine": {
      "type": "object", "additionalProperties": false,
      "required": ["quarantine_id", "admission_id", "phase_id", "reason", "recorded_at", "domains", "evidence_refs"],
      "properties": {
        "quarantine_id": {"$ref": "#/$defs/id"}, "admission_id": {"$ref": "#/$defs/id"}, "phase_id": {"$ref": "#/$defs/id"},
        "reason": {"enum": ["EXTERNAL_SIDE_EFFECT_UNKNOWN", "NON_FENCEABLE_LEASE_EXPIRED"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "domains": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quarantineDomain"}},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "workspaceQuarantine": {
      "type": "object", "additionalProperties": false,
      "required": ["quarantine_id", "admission_id", "phase_id", "reason", "recorded_at", "evidence_refs"],
      "properties": {
        "quarantine_id": {"$ref": "#/$defs/id"}, "admission_id": {"$ref": "#/$defs/id"}, "phase_id": {"$ref": "#/$defs/id"},
        "reason": {"const": "WORKSPACE_AUTHORITY_UNKNOWN"}, "recorded_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "eventBinding": {
      "type": "object", "additionalProperties": false, "required": ["sequence", "event_id", "path", "sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1}, "event_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "pattern": "^runtime[/\\\\]workspace_coordination_events[/\\\\][A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
