{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:transaction-journal:1",
  "title": "MALTS Transaction Journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journal_id", "operation_id", "plan_hash", "state", "state_history", "last_completed_action", "recovery_actions", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "journal_id": {"$ref": "#/$defs/id"},
    "operation_id": {"$ref": "#/$defs/id"},
    "plan_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "state": {"$ref": "#/$defs/state"},
    "state_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateEvent"}},
    "last_completed_action": {"type": ["string", "null"], "minLength": 1},
    "recovery_actions": {"type": "array", "items": {"$ref": "#/$defs/recoveryAction"}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "state": {"enum": ["DISCOVER", "LOCK", "PLAN", "STAGE", "SNAPSHOT", "PREVALIDATE", "ACTIVATE", "POSTVALIDATE", "CLEAN", "COMMIT", "ROLLBACK", "FAILED"]},
    "stateEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "at", "evidence_refs"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "at": {"type": "string", "format": "date-time"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "recoveryAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "status", "evidence_refs"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "completed", "failed"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
