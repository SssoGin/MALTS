{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:workspace-reorganization-plan:current",
  "title": "MALTS Current Workspace Reorganization Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "operation_id", "operation", "plan_id", "workspace_identity",
    "source_layout", "target_contract", "target_profile", "root_control", "inputs", "outputs",
    "compatibility", "rollback", "review", "implementation_binding", "declarations",
    "plan_sha256"
  ],
  "properties": {
    "contract_id": {"const": "malts.workspace.reorganization-plan"},
    "operation_id": {"$ref": "#/$defs/id"},
    "operation": {"const": "reorganize-workspace"},
    "plan_id": {"$ref": "#/$defs/id"},
    "workspace_identity": {
      "type": "object", "additionalProperties": false, "required": ["project_id"],
      "properties": {"project_id": {"$ref": "#/$defs/id"}}
    },
    "source_layout": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "legacy_schema_version", "state_sha256"],
      "properties": {
        "kind": {"enum": ["CURRENT", "LEGACY"]},
        "legacy_schema_version": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "state_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target_contract": {"const": "malts.workspace.current"},
    "target_profile": {"enum": ["single_phase", "resource_admission"]},
    "root_control": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "source", "candidate", "target", "archive", "section_dispositions", "limits"],
      "properties": {
        "action": {"enum": ["UNCHANGED", "REPLACED_AND_ARCHIVED"]},
        "source": {"$ref": "#/$defs/rootDocument"},
        "candidate": {"anyOf": [{"$ref": "#/$defs/candidateDocument"}, {"type": "null"}]},
        "target": {"$ref": "#/$defs/rootDocument"},
        "archive": {"anyOf": [{"$ref": "#/$defs/archive"}, {"type": "null"}]},
        "section_dispositions": {
          "type": "array", "minItems": 15, "maxItems": 15,
          "items": {"$ref": "#/$defs/sectionDisposition"}
        },
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["fresh_target_lines", "fresh_target_bytes", "reorganized_target_lines", "reorganized_target_bytes", "soft_max_lines", "soft_max_bytes"],
          "properties": {
            "fresh_target_lines": {"const": 150}, "fresh_target_bytes": {"const": 12288},
            "reorganized_target_lines": {"const": 220}, "reorganized_target_bytes": {"const": 20480},
            "soft_max_lines": {"const": 1500}, "soft_max_bytes": {"const": 262144}
          }
        }
      }
    },
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["result", "legacy_read_preserved", "intermediate_layouts_written", "entities_created"],
      "properties": {
        "result": {"enum": ["ALREADY_CURRENT", "REORGANIZATION_REQUIRED", "COMPATIBLE"]},
        "legacy_read_preserved": {"type": "boolean"},
        "intermediate_layouts_written": {"const": false},
        "entities_created": {
          "type": "object", "additionalProperties": false,
          "required": ["phase", "session", "agent", "artifact", "workspace"],
          "properties": {
            "phase": {"const": 0}, "session": {"const": 0}, "agent": {"const": 0},
            "artifact": {"const": 0}, "workspace": {"const": 0}
          }
        }
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["preimages", "created_outputs", "strategy"],
      "properties": {
        "preimages": {"type": "array", "items": {"$ref": "#/$defs/preimage"}},
        "created_outputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "strategy": {"const": "TRANSACTION_JOURNAL_EXACT_PREIMAGE"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["review_ref", "authorization_ref", "planned_at"],
      "properties": {
        "review_ref": {"type": "string", "minLength": 1},
        "authorization_ref": {"type": "string", "minLength": 1},
        "planned_at": {"type": "string", "format": "date-time"}
      }
    },
    "implementation_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_path", "tool_sha256", "invariant_path", "invariant_sha256", "malts_version"],
      "properties": {
        "tool_path": {"const": "tools/long_workspace.py"}, "tool_sha256": {"$ref": "#/$defs/sha256"},
        "invariant_path": {"const": "tools/lifecycle_invariants.json"}, "invariant_sha256": {"$ref": "#/$defs/sha256"},
        "malts_version": {"type": "string", "minLength": 1}
      }
    },
    "declarations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "implicit_session_created", "implicit_agent_created", "implicit_artifact_created",
        "implicit_phase_created", "recursive_discovery_performed", "git_or_network_performed",
        "active_runtime_or_public_touched"
      ],
      "properties": {
        "implicit_session_created": {"const": false}, "implicit_agent_created": {"const": false},
        "implicit_artifact_created": {"const": false}, "implicit_phase_created": {"const": false},
        "recursive_discovery_performed": {"const": false}, "git_or_network_performed": {"const": false},
        "active_runtime_or_public_touched": {"const": false}
      }
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^[A-Za-z]:|^[/\\\\]|(^|[/\\\\])\\.\\.([/\\\\]|$))"}},
    "input": {
      "type": "object", "additionalProperties": false, "required": ["path", "role", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "role": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["path", "role", "bytes", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "role": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "preimage": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"}}
    },
    "rootDocument": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "lines", "bytes"],
      "properties": {
        "path": {"const": "PROJECT_CONTROL.md"}, "sha256": {"$ref": "#/$defs/sha256"},
        "lines": {"type": "integer", "minimum": 1}, "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "candidateDocument": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "lines", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"},
        "lines": {"type": "integer", "minimum": 1, "maximum": 220},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 20480}
      }
    },
    "archive": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "source_sha256", "source_bytes", "archive_sha256", "archive_bytes", "embedded_offset", "embedded_bytes_preserved"],
      "properties": {
        "path": {"const": "history/PROJECT_CONTROL_HISTORY.md"},
        "source_sha256": {"$ref": "#/$defs/sha256"}, "source_bytes": {"type": "integer", "minimum": 1},
        "archive_sha256": {"$ref": "#/$defs/sha256"}, "archive_bytes": {"type": "integer", "minimum": 1},
        "embedded_offset": {"type": "integer", "minimum": 0}, "embedded_bytes_preserved": {"const": true}
      }
    },
    "sectionDisposition": {
      "type": "object", "additionalProperties": false, "required": ["section", "disposition"],
      "properties": {
        "section": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["KEEP_PROJECT", "MOVE_TO_PHASE", "ARCHIVE_HISTORY", "OMIT_DERIVED"]}
      }
    }
  }
}
