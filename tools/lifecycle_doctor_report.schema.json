{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:lifecycle-doctor-report:1",
  "title": "MALTS Lifecycle Doctor Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "mode",
    "writes_performed",
    "lifecycle_root",
    "selected_tools",
    "active_generation_id",
    "core_trust",
    "trusted_repair_source",
    "mismatches",
    "evidence",
    "suggested_commands",
    "checked_at"
  ],
  "properties": {
    "external_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "mode", "writes_performed", "execution_authorized", "scope", "complete_global_inventory", "status", "files"],
      "properties": {
        "format": {"const": "malts.mcp-configuration-check"},
        "mode": {"const": "READ_ONLY"},
        "writes_performed": {"const": false},
        "execution_authorized": {"const": false},
        "atomic_snapshot": {"const": false},
        "scope": {"const": "KNOWN_HOST_LOCATIONS_AND_EXPLICIT_FILES"},
        "reason": {"type": "string"},
        "complete_global_inventory": {"const": false},
        "files": {"type": "array", "items": {"$ref": "#/$defs/hostConfigurationFile"}},
        "reprojection_required": {"type": "array", "items": {"$ref": "#/$defs/reprojection"}},
        "status": {"enum": ["CURRENT", "NOT_CONFIGURED", "DRIFT", "UNVERIFIED", "CHECK_FAILED"]}
      }
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "UNTRUSTED",
        "NOT_INSTALLED"
      ]
    },
    "mode": {
      "const": "READ_ONLY"
    },
    "writes_performed": {
      "const": false
    },
    "lifecycle_root": {
      "$ref": "#/$defs/absolutePath"
    },
    "selected_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex",
          "claude-code",
          "opencode",
          "deepseek-harness",
          "deepseek-desktop"
        ]
      }
    },
    "active_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "core_trust": {
      "enum": [
        "LOCALLY_CONSISTENT",
        "EXTERNAL_SOURCE_REQUIRED",
        "UNAVAILABLE"
      ]
    },
    "trusted_repair_source": {
      "enum": [
        "ACTIVE_GENERATION",
        "VERIFIED_EXTERNAL_REQUIRED",
        "NONE"
      ]
    },
    "mismatches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mismatch"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "suggested_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "hostConfigurationFile": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "path", "status", "entries", "sha256"],
      "properties": {
        "host": {"type": "string"}, "path": {"type": "string"},
        "status": {"enum": ["NOT_CONFIGURED", "CURRENT", "VALID_OLDER_GENERATION", "INVALID", "DIFFERENT", "CHECK_FAILED", "UNSUPPORTED"]},
        "sha256": {"type": ["string", "null"]}, "reason": {"type": "string"},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/hostConfigurationEntry"}}
      }
    },
    "hostConfigurationEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["server_name", "status", "issues", "differences"],
      "properties": {
        "server_name": {"type": "string"}, "status": {"type": "string"},
        "issues": {"type": "array", "items": {"type": "string"}},
        "generation_id": {"type": ["string", "null"]},
        "binding": {"$ref": "#/$defs/hostBinding"},
        "suggested_values": {"$ref": "#/$defs/hostBinding"},
        "regeneration_arguments": {"type": "array", "items": {"type": "string"}},
        "regeneration_note": {"type": "string"},
        "differences": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["field", "observed", "expected"],
          "properties": {"field": {"type": "string"}, "observed": {"type": ["string", "boolean", "null"]}, "expected": {"type": ["string", "boolean", "null"]}}}}
      }
    },
    "hostBinding": {
      "type": "object", "additionalProperties": false,
      "properties": {"script": {"type": "string"}, "state-dir": {"type": "string"}, "resource-root": {"type": "string"}, "project-id": {"type": "string"}}
    },
    "reprojection": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "path", "server_name", "status", "issues", "suggested_values", "regeneration_arguments"],
      "properties": {
        "host": {"type": "string"}, "path": {"type": "string"}, "server_name": {"type": "string"}, "status": {"type": "string"},
        "issues": {"type": "array", "items": {"type": "string"}},
        "suggested_values": {"$ref": "#/$defs/hostBinding"},
        "regeneration_arguments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\)[^<>|?*]+$"
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "surface",
        "expected_locator",
        "observed_locator",
        "expected",
        "observed",
        "trust_impact",
        "suggested_command"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^DOC_[A-Z0-9_]+$"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "expected_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/absolutePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/absolutePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed": {
          "type": [
            "string",
            "null"
          ]
        },
        "trust_impact": {
          "enum": [
            "DERIVED_ONLY",
            "CORE_INVALID",
            "INFORMATIONAL"
          ]
        },
        "suggested_command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "path",
        "sha256",
        "status"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            {
              "enum": [
                "MISSING",
                "UNTRUSTED",
                "UNSUPPORTED"
              ]
            }
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "MISSING",
            "DRIFT",
            "INVALID",
            "UNTRUSTED"
          ]
        }
      }
    }
  }
}
