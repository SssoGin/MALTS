{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:tool-projection-manifest:2",
  "title": "MALTS Installed Tool Projection Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "generation_id",
    "artifact_sha256",
    "entries",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "tool": {
      "enum": [
        "codex",
        "claude-code",
        "opencode",
        "deepseek-harness",
        "deepseek-desktop"
      ]
    },
    "generation_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "boot_path": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "source_sha256",
        "installed_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "replace",
            "managed-block",
            "boot-pointer"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "rendered_managed_block_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "managed_block_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "installed_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "boot_path": {
          "type": "string",
          "minLength": 1
        },
        "merge_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "insertion"
          ],
          "properties": {
            "insertion": {
              "enum": [
                "created",
                "append-ended-newline",
                "append-added-newline",
                "preexisting-marker"
              ]
            }
          }
        }
      }
    }
  }
}
