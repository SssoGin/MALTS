{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:result-reorganization-plan:current",
  "title": "MALTS Current Result Reorganization Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "operation_id", "operation", "source", "target", "inputs", "outputs", "rollback", "review", "implementation_binding", "declarations", "plan_sha256"],
  "properties": {
    "contract_id": {"const": "malts.result.reorganization-plan"},
    "operation_id": {"$ref": "#/$defs/id"},
    "operation": {"const": "reorganize-result-contract"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "layout"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "layout": {"enum": ["LEGACY_1", "LEGACY_2", "LEGACY_3", "CURRENT"]}}
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["contract_id", "path", "sha256", "revision_id", "execution_authority"],
      "properties": {
        "contract_id": {"const": "malts.result.current"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"},
        "revision_id": {"$ref": "#/$defs/id"}, "execution_authority": {"$ref": "#/$defs/executionAuthority"}
      }
    },
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}},
    "rollback": {
      "type": "object", "additionalProperties": false, "required": ["preimages", "created_outputs", "strategy"],
      "properties": {
        "preimages": {"type": "array", "items": {"$ref": "#/$defs/preimage"}},
        "created_outputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "strategy": {"const": "TRANSACTION_JOURNAL_EXACT_PREIMAGE"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["review_ref", "authorization_ref", "planned_at"],
      "properties": {"review_ref": {"type": "string", "minLength": 1}, "authorization_ref": {"type": "string", "minLength": 1}, "planned_at": {"type": "string", "format": "date-time"}}
    },
    "implementation_binding": {
      "type": "object", "additionalProperties": false, "required": ["tool_path", "tool_sha256", "invariant_path", "invariant_sha256", "malts_version"],
      "properties": {"tool_path": {"const": "tools/long_workspace.py"}, "tool_sha256": {"$ref": "#/$defs/sha256"}, "invariant_path": {"const": "tools/lifecycle_invariants.json"}, "invariant_sha256": {"$ref": "#/$defs/sha256"}, "malts_version": {"type": "string", "minLength": 1}}
    },
    "declarations": {
      "type": "object", "additionalProperties": false,
      "required": ["source_bytes_unchanged", "intermediate_contract_written", "implicit_session_created", "implicit_agent_created", "implicit_artifact_created", "implicit_phase_created", "recursive_discovery_performed", "git_or_network_performed"],
      "properties": {
        "source_bytes_unchanged": {"const": true}, "intermediate_contract_written": {"const": false},
        "implicit_session_created": {"const": false}, "implicit_agent_created": {"const": false}, "implicit_artifact_created": {"const": false},
        "implicit_phase_created": {"const": false}, "recursive_discovery_performed": {"const": false}, "git_or_network_performed": {"const": false}
      }
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^[A-Za-z]:|^[/\\\\]|(^|[/\\\\])\\.\\.([/\\\\]|$))"}},
    "executionAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "admission_id", "actor_id", "phase_control_sha256", "fencing_tokens"],
      "properties": {
        "profile": {"enum": ["NONE", "RESOURCE_ADMISSION"]},
        "admission_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "actor_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "phase_control_sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"},
        "fencing_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["domain_id", "epoch"], "properties": {"domain_id": {"$ref": "#/$defs/id"}, "epoch": {"type": "integer", "minimum": 1}}}}
      }
    },
    "input": {"type": "object", "additionalProperties": false, "required": ["path", "role", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "role": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["path", "role", "bytes", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "role": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "preimage": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"}}}
  }
}
