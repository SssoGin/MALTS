{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:growth-signal:1",
  "title": "MALTS Growth Signal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_id", "source_task_id", "signal_type", "fact_evidence", "observed_at", "sensitivity", "redacted"],
  "properties": {
    "schema_version": {"const": 1},
    "signal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "signal_type": {"enum": ["user_correction", "verification_failure", "wrong_assumption", "useful_check", "repeated_pattern", "explicit_request"]},
    "fact_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observed_at": {"type": "string", "format": "date-time"},
    "sensitivity": {"enum": ["public", "internal", "sensitive", "secret"]},
    "redacted": {"type": "boolean"}
  }
}
