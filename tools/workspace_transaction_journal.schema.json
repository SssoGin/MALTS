{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:workspace-transaction-journal:1",
  "title": "MALTS Workspace Transaction Journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journal_schema", "operation_id", "operation", "plan_sha256", "workspace_id",
    "invariant_source_sha256", "command_version", "created_at", "state", "state_history",
    "journal_path", "lock_path", "inputs", "targets", "replacement_cursor",
    "replacement_count", "validation_steps", "declarations", "attempt", "attempt_history",
    "failure", "recovery", "completed_at"
  ],
  "properties": {
    "journal_schema": {"const": 1},
    "operation_id": {"$ref": "#/$defs/id"},
    "operation": {"type": "string", "minLength": 1},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "workspace_id": {"type": "string", "minLength": 1},
    "invariant_source_sha256": {"$ref": "#/$defs/sha256"},
    "command_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "state": {"$ref": "#/$defs/state"},
    "state_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateEvent"}},
    "journal_path": {"type": "string", "pattern": "^runtime[/\\\\]workspace_transactions[/\\\\][A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$"},
    "lock_path": {"const": "runtime/workspace_transaction.lock.json"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "replacement_cursor": {"type": "integer", "minimum": 0},
    "replacement_count": {"type": "integer", "minimum": 0},
    "validation_steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "declarations": {"$ref": "#/$defs/declarations"},
    "attempt": {"type": "integer", "minimum": 1},
    "attempt_history": {"type": "array", "items": {"$ref": "#/$defs/attemptHistory"}},
    "failure": {"$ref": "#/$defs/nullableFailure"},
    "recovery": {"$ref": "#/$defs/nullableRecovery"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "relativePath": {"type": "string", "pattern": "^(?![A-Za-z]:|[/\\\\]|.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"},
    "state": {"enum": ["PREPARED", "IN_PROGRESS", "ROLLING_BACK", "ROLLED_BACK", "RECOVERY_REQUIRED", "COMMITTED"]},
    "role": {"enum": ["IMMUTABLE_RECORD", "RESULT_PROJECTION", "SESSION_CONTROL", "PHASE_CONTROL", "REPORT", "HANDOFF", "PROJECT_CONTROL", "RUNTIME_STATE"]},
    "stateEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "at", "replacement_cursor", "evidence_refs"],
      "properties": {
        "state": {"$ref": "#/$defs/state"}, "at": {"type": "string", "format": "date-time"},
        "replacement_cursor": {"type": "integer", "minimum": 0},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "expected_preimage", "changed"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "expected_preimage": {"type": "string", "pattern": "^(ABSENT|[A-F0-9]{64})$"},
        "changed": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "order", "original_existed", "original_bytes", "original_sha256", "original_base64", "planned_sha256", "planned_bytes", "stage_path", "stage_sha256", "replacement_state"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"}, "role": {"$ref": "#/$defs/role"},
        "order": {"type": "integer", "minimum": 1}, "original_existed": {"type": "boolean"},
        "original_bytes": {"type": ["integer", "null"], "minimum": 0},
        "original_sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"},
        "original_base64": {"type": ["string", "null"]},
        "planned_sha256": {"$ref": "#/$defs/sha256"}, "planned_bytes": {"type": "integer", "minimum": 0},
        "stage_path": {"type": ["string", "null"]}, "stage_sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"},
        "replacement_state": {"enum": ["PENDING", "STAGED", "REPLACED", "RESTORED"]}
      }
    },
    "declarations": {
      "type": "object", "additionalProperties": false,
      "required": ["implicit_session_created", "artifact_enrollment_performed", "vcs_commands_performed", "network_calls_performed"],
      "properties": {
        "implicit_session_created": {"const": false}, "artifact_enrollment_performed": {"const": false},
        "vcs_commands_performed": {"const": false}, "network_calls_performed": {"const": false}
      }
    },
    "nullableFailure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "message", "fault_point"],
          "properties": {
            "type": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1},
            "fault_point": {"type": ["string", "null"], "minLength": 1}
          }
        }
      ]
    },
    "nullableRecovery": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "started_at", "completed_at", "result"],
          "properties": {
            "mode": {"enum": ["PREIMAGE_RESTORE", "LOCK_ONLY", "COMMIT_FINALIZATION"]},
            "started_at": {"type": "string", "format": "date-time"},
            "completed_at": {"type": ["string", "null"], "format": "date-time"},
            "result": {"type": ["string", "null"], "minLength": 1}
          }
        }
      ]
    },
    "attemptHistory": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "state", "failed_at", "failure"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1}, "state": {"$ref": "#/$defs/state"},
        "failed_at": {"type": ["string", "null"], "format": "date-time"}, "failure": {"$ref": "#/$defs/nullableFailure"}
      }
    }
  }
}
