{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:user-status-report:current",
  "title": "MALTS Current User Status Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "operation", "requested_language", "narrative_language", "language",
    "language_source", "fallback_language", "catalog", "items", "rendered_chain",
    "unknown_codes", "writes_performed"
  ],
  "properties": {
    "contract_id": {"const": "malts.user-status-report.current"},
    "operation": {"const": "render-user-status"},
    "requested_language": {"type": ["string", "null"]},
    "narrative_language": {"type": ["string", "null"]},
    "language": {"enum": ["en", "zh-CN"]},
    "language_source": {"enum": ["EXPLICIT", "NARRATIVE_LANGUAGE", "FALLBACK"]},
    "fallback_language": {"const": "en"},
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "runtime/status/user_status_labels.json"},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/item"}
    },
    "rendered_chain": {"type": "string", "minLength": 1, "maxLength": 16384},
    "unknown_codes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/code"}},
    "writes_performed": {"const": false}
  },
  "$defs": {
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "code", "label", "rendered", "known"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 64},
        "code": {"$ref": "#/$defs/code"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "rendered": {"type": "string", "minLength": 1, "maxLength": 320},
        "known": {"type": "boolean"}
      }
    }
  }
}
