{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:capability-descriptor:1",
  "title": "MALTS Capability Descriptor",
  "description": "Canonical self-description paired with one MALTS-owned SKILL.md source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "skill_id",
    "declared_name",
    "projected_names",
    "display_name",
    "short_description",
    "triggers",
    "applicability",
    "inputs",
    "outputs",
    "risks",
    "required_permissions",
    "dependencies",
    "supported_tools",
    "package_variants",
    "tool_metadata",
    "verification"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "capability_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "declared_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "projected_names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude-code", "opencode"],
      "properties": {
        "codex": {"type": "string", "pattern": "^malts-[a-z0-9][a-z0-9-]+$"},
        "claude-code": {"type": "string", "pattern": "^malts-[a-z0-9][a-z0-9-]+$"},
        "opencode": {"type": "string", "pattern": "^malts-[a-z0-9][a-z0-9-]+$"}
      }
    },
    "display_name": {"type": "string", "pattern": "^MALTS .+$", "minLength": 7},
    "short_description": {"type": "string", "minLength": 25, "maxLength": 96},
    "triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_types", "modes", "conditions", "contraindications"],
      "properties": {
        "task_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["single-agent", "preflight", "multi-agent", "release", "handoff", "review-only"]}
        },
        "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contraindications": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_class", "factors", "forbidden_effects"],
      "properties": {
        "risk_class": {"enum": ["low", "medium", "high", "critical"]},
        "factors": {"type": "array", "uniqueItems": true, "items": {"enum": ["scripts", "write", "network", "credentials", "destructive", "self-modifying", "external-runtime"]}},
        "forbidden_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "required_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "read-files",
          "write-project-files",
          "write-local-canonical",
          "write-global-state",
          "tool-invocation",
          "agent-dispatch",
          "git-read",
          "git-write",
          "network",
          "install-dependency",
          "delete-managed-files",
          "release"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "required", "source_relative_path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["skill", "agent", "tool", "runtime", "file", "service"]},
          "required": {"type": "boolean"},
          "source_relative_path": {"type": ["string", "null"]}
        }
      }
    },
    "supported_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["codex", "claude-code", "opencode"]}
    },
    "package_variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["local", "public"]}
    },
    "tool_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude-code", "opencode"],
      "properties": {
        "codex": {"$ref": "#/$defs/toolMetadata"},
        "claude-code": {"$ref": "#/$defs/toolMetadata"},
        "opencode": {"$ref": "#/$defs/toolMetadata"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "levels", "evidence_refs"],
      "properties": {
        "status": {"enum": ["unverified", "static-validated", "discovered", "invocation-verified", "behavior-verified", "reverify-required"]},
        "levels": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["static", "discovery", "invocation", "behavior"]}
        },
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "toolMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_type", "include_openai_metadata"],
      "properties": {
        "projection_type": {"const": "native"},
        "include_openai_metadata": {"type": "boolean"}
      }
    }
  }
}
