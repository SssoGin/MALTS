{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:malts:schema:result-migration-plan:1",
  "title": "MALTS Result Contract v1-to-v2 Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_id", "operation", "plan_id", "source", "target",
    "created", "binding_mode", "declarations", "rollback", "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"$ref": "#/$defs/id"},
    "operation": {"const": "migrate-result-contract-v1-to-v2"},
    "plan_id": {"$ref": "#/$defs/id"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "contract_version", "execution_status", "terminal_status"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|[/\\\\]|.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "contract_version": {"const": "1"},
        "execution_status": {"type": "string", "minLength": 1},
        "terminal_status": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "lineage_id", "phase_id", "phase_boundary_revision_id", "phase_boundary_revision_sha256"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "lineage_id": {"$ref": "#/$defs/id"},
        "phase_id": {"$ref": "#/$defs/id"},
        "phase_boundary_revision_id": {"$ref": "#/$defs/id"},
        "phase_boundary_revision_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "created": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v2_contract_path", "import_event_path", "projection_path"],
      "properties": {
        "v2_contract_path": {"type": "string", "pattern": "^task-state[/\\\\][A-Za-z0-9._-]+[/\\\\]contracts[/\\\\][A-Za-z0-9._-]+\\.json$"},
        "import_event_path": {"type": "string", "pattern": "^task-state[/\\\\][A-Za-z0-9._-]+[/\\\\]events[/\\\\]1-[A-Za-z0-9._-]+\\.json$"},
        "projection_path": {"type": "string", "pattern": "^task-state[/\\\\][A-Za-z0-9._-]+[/\\\\]RESULT_LINEAGE\\.json$"}
      }
    },
    "binding_mode": {"enum": ["V4_BOUND", "PENDING_WORKSPACE_BINDING"]},
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_bytes_unchanged", "fabricated_history", "implicit_session_created", "recursive_discovery_performed", "git_or_network_performed"],
      "properties": {
        "source_bytes_unchanged": {"const": true},
        "fabricated_history": {"const": false},
        "implicit_session_created": {"const": false},
        "recursive_discovery_performed": {"const": false},
        "git_or_network_performed": {"const": false}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preimages", "created_outputs"],
      "properties": {
        "preimages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/preimageRow"}
        },
        "created_outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?![A-Za-z]:|[/\\\\]|.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"}
        }
      }
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"},
    "preimageRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|[/\\\\]|.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"},
        "sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    }
  }
}
